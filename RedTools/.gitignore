# ===== RedTools 忽略规则 =====

# 构建产物（build_all.py 全量生成，不入库）
dist/

# 发布目录：全部生成物不入库。
# 发布文案.txt 为人工维护唯一入库项，提交时用 git add -f 强制添加
# （gitignore 的 ! 反向规则无法恢复已忽略目录内的文件，故用 -f）
publish/

# 压缩包（zip 产物 + skill 源包，源包已解压到 .skill/ 入库）
# 注意：*.skill 会误伤 .skill/ 目录（模式匹配任意路径段），
#       故源包仅精确忽略根目录下的 skill 源包文件名。
*.zip
minitool-zip-builder-1.6.0.skill

# Python
__pycache__/
*.py[cod]

# 批量生图工具：API Key 配置与运行状态（含密钥，绝不入库）
批量生图工具/keys.json
批量生图工具/key_state.json
批量生图工具/tasks/*/done.json

# 重绘工具：生成物 / 素材 / 密钥不入库（源码与脚本入库）
重绘工具/tasks/                     # 重绘任务输入输出（图片素材，体积大）
重绘工具/key_state.json             # API Key 额度状态（含密钥线索）
重绘工具/qa_reports/*.html          # 质检报告生成物（gen_qa_reports.py 重新生成）
重绘工具/quality_data.json          # 自动质检生成物
重绘工具/quality_report.html        # 自动质检报告生成物
重绘工具/_shot_*.png                # 工具截图
重绘工具/hotzone_editor/_shot_*.png

# 临时 / 系统
*.tmp
*.bak
Thumbs.db
.DS_Store
/dbg_*.png
/shot-*.png
