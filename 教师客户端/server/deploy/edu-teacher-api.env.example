# edu-teacher-api · 生产环境变量模板（D03 附录 A / §7）
# 安装：cp edu-teacher-api.env.example /etc/edu-teacher-api.env && chmod 600 /etc/edu-teacher-api.env
# ⚠ 全部为真实密钥占位——生成方法见同目录 README.md §密钥

# 必配：JWT 签名密钥（≥32 字节随机；换钥 = 全体教师 JWT 失效，需重新登录）
JWT_SECRET=

# 必配（生产）：ed25519 口令包签名私钥（PKCS8 PEM，单行 \n 转义或用 $(printf ...) 写入）
# ⚠ 公私钥配对随壳分发——丢失或更换 = 已发壳端验签失败；务必备份私钥
LICENSE_SIGN_KEY=
LICENSE_SIGN_KEY_ID=license-sign-2026

# 必配：内容包上传管理密钥（publish_pack.py --api-key 用）
PKG_ADMIN_KEY=

# 生产接真短信前置 false（当前腾讯云短信未接入 → 保持 true 或留空=默认 true）
SMS_MOCK=true
