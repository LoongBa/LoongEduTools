{
  "name": "math-smart-calc",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen_stages.mjs && vite --port 3016 --host 0.0.0.0 --strictPort",
    "build": "node scripts/gen_stages.mjs && vite build",
    "build:online": "node scripts/gen_stages.mjs && vite build --mode online",
    "preview": "vite preview --port 3016 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "test:engine": "node --experimental-strip-types tests/engine.mjs"
  },
  "sideEffects": [
    "./src/assets/smart_gen/*.js",
    "./src/styles.css"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lightningcss": "^1.30.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}