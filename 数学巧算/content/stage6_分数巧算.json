        "question": "能不能把 6 「发」给每个分数？"
      },
      "explore": {
        "model": "area",
        "steps": [
          "分配律：a × (b + c) = a × b + a × c",
          "(1/2 + 1/3) × 6 = (1/2)×6 + (1/3)×6",
          "(1/2)×6：6 与 2 约 → 3；(1/3)×6：6 与 3 约 → 2",
          "3 + 2 = 5——乘 6 反而把分母约掉了，比通分快得多"
        ]
      },
      "method": {
        "rhyme": "括号里分数相加减、外面乘整数 → 分配出去用约分消分母；有公因数就提取",
        "steps": [
          "括号里是分数加减、外面乘整数 → 试着分配出去",
          "每个分数与整数约分式相乘",
          "结果相加减",
          "有公因数就逆用提取"
        ]
      },
      "examples": [
        {
          "expr": "(1/2 + 1/3) × 6",
          "normal": "通分：3/6+2/6=5/6，再×6=5",
          "smart": "(1/2)×6 + (1/3)×6 = 3 + 2 = 5",
          "answer": 5,
          "accepted": [
            5
          ],
          "why": "6 分别约掉分母 2 和 3"
        },
        {
          "expr": "(7/8 − 1/4) × 16",
          "normal": "通分：7/8−2/8=5/8，×16=10",
          "smart": "(7/8)×16 − (1/4)×16 = 14 − 4 = 10",
          "answer": 10,
          "accepted": [
            10
          ],
          "why": "16 约掉 8 得 14、约掉 4 得 4"
        },
        {
          "expr": "(5/9) × 18 + (4/9) × 18",
          "normal": "分别算：10 + 8 = 18",
          "smart": "(5/9 + 4/9) × 18 = 1 × 18 = 18",
          "answer": 18,
          "accepted": [
            18
          ],
          "why": "逆用提公因数 18，括号里 5/9+4/9=1"
        }
      ],
      "mistakes": [
        {
          "wrong": "(7/8 − 1/4) × 16 = 14 + 4 = 18",
          "reason": "分配律展开时括号里的加减号要照抄，(1/4)×16 = 4 前面是减号"
        },
        {
          "wrong": "(1/2 + 1/3) × 6 = 3（只发了一个分数）",
          "reason": "分配律必须逐项分配，每个加数都要乘；漏乘一项结果就错"
        }
