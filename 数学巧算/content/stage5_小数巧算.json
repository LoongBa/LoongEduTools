      "lesson_id": "s5l1",
      "title": "化整还原（小数数位）",
      "goal": "掌握「化整→巧算→还原」三步完成小数乘法。",
      "principle": "小数就是整数按倍数缩小：先按整数算，算完按缩小的倍数除回来；积的小数位数 = 因数小数位数之和，是还原的依据。",
      "prereq": [
        "小数意义：0.1、0.01 表示十分之一、百分之一",
        "小数点移动：向右一位、两位，数 ×10、×100"
      ],
      "situation": {
        "text": "3.5 × 2：带着小数点算，心里总怕点错位置。",
        "question": "能不能先不管小数点？"
      },
      "explore": {
        "model": "numberline",
        "steps": [
          "在数轴上 3.5 表示 35 个 0.1（3.5 = 35 ÷ 10）",
          "先按整数算：35 × 2 = 70",
          "再还原：70 ÷ 10 = 7（在数轴上从 70 缩小 10 倍回 7）",
          "积的小数位数 = 因数小数位数之和，两个因数都有小数时位数相加"
        ]
      },
      "method": {
        "rhyme": "化整、巧算、还原——先当整数算，数位点回小数点",
        "steps": [
          "把每个小数先按整数算（乘 10/100/1000 化整）",
          "用学过的整数巧算",
          "数因数共有几位小数，从右往左点小数点还原"
        ]
      },
      "examples": [
        {
          "expr": "3.5 × 2",
          "normal": "列竖式：3.5×2，一位小数，点一位小数点",
          "smart": "35 × 2 = 70，÷10 = 7",
          "answer": 7,
          "accepted": [
            7
          ],
          "why": "先当整数算避开小数点，最后 ÷10 还原"
        },
        {
          "expr": "0.6 × 4",
          "normal": "列竖式：0.6×4，一位小数",
          "smart": "6 × 4 = 24，÷10 = 2.4",
          "answer": 2.4,
          "accepted": [
            2.4
          ],
          "why": "一位小数缩小 10 倍算，还原一位"
        },
        {
          "expr": "2.4 × 3",
          "normal": "列竖式：2.4×3，一位小数",
          "smart": "24 × 3 = 72，÷10 = 7.2",
          "answer": 7.2,
          "accepted": [
            7.2
          ],
          "why": "化整后整数口算，还原一位"
        },
        {
          "expr": "0.25 × 4",
          "normal": "列竖式：0.25×4，两位小数",
          "smart": "25 × 4 = 100，两位小数 → 1.00 = 1",
          "answer": 1,
          "accepted": [
            1
          ],
          "why": "两因数共 2 位小数，积从 100 点回两位"
        }
      ],
      "mistakes": [
