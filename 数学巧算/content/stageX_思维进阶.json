        "steps": [
          "首尾配对：1 + 100 = 101，2 + 99 = 101，3 + 98 = 101……每对的和都相等",
          "100 个数配成 50 对：101 × 50 = 5050",
          "公式：和 = (首项 + 末项) × 项数 ÷ 2",
          "换个角度：这串数的「平均大小」 = (首项+末项)÷2，和 = 平均数 × 个数——和移多补少是同一件事"
        ]
      },
      "method": {
        "rhyme": "首尾配对，每对和相等；和 = (首项+末项) × 项数 ÷ 2",
        "steps": [
          "首项 + 末项",
          "数项数（项数 = (末项−首项)÷公差 + 1）",
          "(首项+末项) × 项数 ÷ 2",
          "奇数个时，中间那个数单独留下"
        ]
      },
      "examples": [
        {
          "expr": "1 + 2 + 3 + … + 100",
          "normal": "逐项累加，100 次",
          "smart": "(1 + 100) × 100 ÷ 2 = 101 × 50 = 5050",
