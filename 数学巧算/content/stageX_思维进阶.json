    {
      "lesson_id": "sxl3",
      "title": "平方差直观（面积模型）",
      "goal": "用面积图理解平方差公式，能口算「接近整百的两个数相乘」。",
      "principle": "两个关于同一整十/整百对称的数相乘：(a+b)(a−b) = a² − b²——大正方形面积减去小正方形面积，差正好拼成长方形。",
      "prereq": [
        "乘法分配律",
        "正方形、长方形面积",
        "乘方（a² 表示 a × a）"
      ],
      "situation": {
        "text": "103 × 97：都不接近整百（一个多 3、一个少 3）。",
        "question": "有没有一个公式能直接口算？"
      },
      "explore": {
        "model": "area",
        "steps": [
          "103 = 100 + 3，97 = 100 − 3，它俩正是「一个多 3、一个少 3」",
          "103 × 97 = (100 + 3) × (100 − 3)",
          "面积图：大正方形边长 100 面积 100²，左上角切掉边长 3 的小正方形（3²）",
          "剩下的部分正好拼成长 (100+3)、宽 (100−3) 的长方形，面积 = (100+3)×(100−3)",
          "所以 (a+b)(a−b) = a² − b²：10000 − 9 = 9991"
        ]
      },
      "method": {
        "rhyme": "两个数关于同一个整十整百对称（一个 +b、一个 −b）→ 直接「整十整百² − b²」",
        "steps": [
          "找出对称基准 a（整十/整百）",
          "算出 b（两个数离基准各多远）",
          "a² − b²",
          "口算结果"
        ]
      },
      "examples": [
        {
          "expr": "103 × 97",
          "normal": "列竖式：三位数相乘",
          "smart": "100² − 3² = 10000 − 9 = 9991",
          "answer": 9991,
          "accepted": [
            9991
          ],
          "why": "关于 100 对称，减 3²"
        },
        {
          "expr": "205 × 195",
          "normal": "列竖式：三位数相乘",
          "smart": "200² − 5² = 40000 − 25 = 39975",
          "answer": 39975,
          "accepted": [
            39975
          ],
          "why": "关于 200 对称，减 5²"
        },
        {
          "expr": "101 × 99",
          "normal": "列竖式",
          "smart": "100² − 1² = 10000 − 1 = 9999",
          "answer": 9999,
          "accepted": [
            9999
          ],
          "why": "b=1 最小，最省"
        }
      ],
      "mistakes": [
        {
          "wrong": "103 × 97 = 10000 − 3 = 9997（只减 b 不减 b²）",
          "reason": "平方差公式减的是 b² = 3² = 9，不是 b = 3；面积差不是长度差"
        },
        {
          "wrong": "103 × 96 用平方差（两数不对称）",
          "reason": "只有关于同一基准一个 +b、一个 −b 才能用；103 和 96 不关于整十整百对称"
        }
      ],
