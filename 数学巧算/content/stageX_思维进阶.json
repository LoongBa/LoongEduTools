      "lesson_id": "sxl2",
      "title": "移多补少求平均数",
      "goal": "会用「移多补少」（基准法）求平均数，把大数相加变成小数口算。",
      "principle": "平均数是「大家都一样多」的那个数——多的补给少的，总数不变；先选基准把每个数变成小差额，总数不变性保证结果正确。",
      "prereq": [
        "平均数 = 总数 ÷ 份数"
      ],
      "situation": {
        "text": "三次跳绳：92、95、98 下。平均几次？直接加再除要进位。",
        "question": "能不能先「估算个基准」再补差？"
      },
      "explore": {
        "model": "numberline",
        "steps": [
          "方法一（直接）：(92 + 95 + 98) ÷ 3 = 285 ÷ 3 = 95",
          "方法二（移多补少）：选基准 90，每个数比 90 多：2、5、8，共多 15",
          "15 平均分给 3 个数，每个补 5：90 + 5 = 95",
          "原理：平均数是「大家都一样多」的那个数——多的补给少的，总数不变；基准法把大数相加变成小数口算"
        ]
      },
      "method": {
        "rhyme": "选基准（整十）→ 算总差额（多为正、少为负）→ 总差额 ÷ 个数 → 基准 + 商",
        "steps": [
          "选一个整十基准",
          "每个数减基准得差额（比基准多为正、少为负）",
          "差额相加得总差额",
          "总差额 ÷ 个数",
          "基准 + 商"
        ]
      },
      "examples": [
        {
          "expr": "92、95、98 的平均数",
          "normal": "(92 + 95 + 98) ÷ 3 = 285 ÷ 3 = 95",
          "smart": "基准 90，差 2 + 5 + 8 = 15，15 ÷ 3 = 5，90 + 5 = 95",
          "answer": 95,
          "accepted": [
            95
          ],
          "why": "大数相加变三个小差额"
        },
        {
          "expr": "88、92、96、100 的平均数",
          "normal": "(88+92+96+100) ÷ 4 = 376 ÷ 4 = 94",
          "smart": "基准 90，差 −2 + 2 + 6 + 10 = 16，16 ÷ 4 = 4，90 + 4 = 94",
          "answer": 94,
          "accepted": [
            94
          ],
          "why": "负数差额也要带上"
        },
        {
          "expr": "五个数平均 72，其中四个是 70、71、73、74，第五个是几？",
          "normal": "72 × 5 = 360，360 − (70+71+73+74) = 72",
          "smart": "差：−2 − 1 + 1 + 2 = 0，第五个要补 0 → 72",
          "answer": 72,
          "accepted": [
            72
          ],
          "why": "差额和为 0，第五个就是基准 72"
        }
      ],
      "mistakes": [
