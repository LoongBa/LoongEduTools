{
  "schema_version": "1.0",
  "unit": "U2",
  "grade": "4A",
  "title": "My friends",
  "topic": "What makes your friends special?",
  "grammar_rule": "he_she",
  "phonics": { "combo": "sh" },

  "abilities": [
    {
      "id": "A1", "desc": "I can talk about my friends.",
      "training_segments": ["S2"],
      "check": {
        "type": "oral_produce",
        "items": ["指着朋友图，用 He's/She's ... 描述外貌性格，至少 2 句."],
        "pass_rule": ">=2 of 3",
        "retrain_segment": "S2"
      }
    },
    {
      "id": "A2", "desc": "I can say what I do with my friends.",
      "training_segments": ["S4"],
      "check": {
        "type": "oral_produce",
        "items": ["说 We ... together. / He/She often ... with me. 至少 2 句."],
        "pass_rule": ">=2 of 3",
        "retrain_segment": "S4"
      }
    },
    {
      "id": "A3", "desc": "I can tell why someone is my friend.",
      "training_segments": ["S3"],
      "check": {
        "type": "oral_produce",
        "items": ["说 My best friend is ... He/She often ..."],
        "pass_rule": "结构完整即可",
        "retrain_segment": "S3"
      }
    },
    {
      "id": "A4", "desc": "I can read and spell words with sh.",
      "training_segments": ["S6"],
      "check": {
        "type": "listen_write",
        "items": ["指认 6 个 sh 词朗读 + 听写 3 个词"],
        "pass_rule": "听写 >=2 of 3",
        "retrain_segment": "S6"
      }
    }
  ],

  "segments": [
    {
