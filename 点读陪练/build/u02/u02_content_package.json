      "slots": [
        { "id": "P1", "text": "I have a friend. Her name is Lily.", "zh": "我有一个朋友。她叫莉莉。", "image": "u02_p1.png", "audio": "u02_p1.mp3", "image_prompt": "介绍朋友的封面小书，扁平卡通，圆角白底，无文字" },
