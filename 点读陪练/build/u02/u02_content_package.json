      "pattern": "Who's your best friend? / My best friend is ___. He/She often ___.",
      "layers": {
        "original": [
          { "id": "s3_orig01", "text": "Who's your best friend?", "zh": "你最好的朋友是谁？", "source": "textbook", "audio": "u02_s3_orig01.mp3" },
          { "id": "s3_orig02", "text": "Chen Jie. She's funny.", "zh": "陈杰。她很有趣。", "source": "textbook", "audio": "u02_s3_orig02.mp3" },
          { "id": "s3_orig03", "text": "She often makes me smile.", "zh": "她经常逗我笑。", "source": "textbook", "audio": "u02_s3_orig03.mp3" },
          { "id": "s3_orig04", "text": "My best friend is John.", "zh": "我最好的朋友是约翰。", "source": "textbook", "audio": "u02_s3_orig04.mp3" }
        ],
        "complete": [
          { "id": "s3_comp01", "text": "He often helps me with English.", "zh": "他经常帮我学英语。", "tags": ["replace:activity"], "audio": "u02_s3_comp01.mp3" },
          { "id": "s3_comp02", "text": "She often reads books with me.", "zh": "她经常和我一起看书。", "tags": ["replace:activity"], "audio": "u02_s3_comp02.mp3" },
          { "id": "s3_comp03", "text": "He often plays football with me.", "zh": "他经常和我一起踢足球。", "tags": ["replace:activity"], "audio": "u02_s3_comp03.mp3" }
        ],
        "extend": [
          { "id": "s3_ext01", "text": "She always makes me happy.", "zh": "她总是让我开心。", "tags": ["extend:verb"], "audio": "u02_s3_ext01.mp3" },
          { "id": "s3_ext02", "text": "He often plays games with me.", "zh": "他经常和我一起玩游戏。", "tags": ["extend:activity"], "audio": "u02_s3_ext02.mp3" },
          { "id": "s3_ext03", "text": "She helps me with Chinese.", "zh": "她帮我学语文。", "tags": ["extend:subject"], "audio": "u02_s3_ext03.mp3" }
        ]
      }
    },

