        "hotspots": [
          { "id": "H1", "text": "I have a new friend.", "zh": "我有一个新朋友。", "audio": "u02_s0_h01.mp3", "image": "u02_s0_h01.png", "image_prompt": "小男孩兴奋地指着旁边的新朋友，暖色调扁平卡通，圆角白底，无文字" },
          { "id": "H2", "text": "He's tall and strong.", "zh": "他又高又壮。", "audio": "u02_s0_h02.mp3", "image": "u02_s0_h02.png", "image_prompt": "高大强壮的小男孩微笑，暖色调扁平卡通，圆角白底，无文字" },
          { "id": "H3", "text": "She's quiet and kind.", "zh": "她安静又善良。", "audio": "u02_s0_h03.mp3", "image": "u02_s0_h03.png", "image_prompt": "安静微笑的小女孩，暖色调扁平卡通，圆角白底，无文字" },
          { "id": "H4", "text": "We play games together.", "zh": "我们一起玩游戏。", "audio": "u02_s0_h04.mp3", "image": "u02_s0_h04.png", "image_prompt": "两个小朋友一起玩游戏，暖色调扁平卡通，圆角白底，无文字" }
        ],
        "locate_items": [
          { "audio": "u02_s0_loc01.mp3", "expect": "H1" },
          { "audio": "u02_s0_loc02.mp3", "expect": "H3" }
        ]
      }
    },

