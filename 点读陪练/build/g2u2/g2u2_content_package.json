      "lines": [
        {
          "id": "s6_01",
          "text": "Let's draw a tree. OK!",
          "zh": "我们来画一棵树吧。好！",
          "audio": "g2u2_s6_01.mp3",
          "image": "g2u2_s6_01.png",
          "image_prompt": "两个小朋友坐在桌前准备画画，桌上铺着画纸和颜料盘，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_02",
          "text": "Look! Your hand! Oh no! My hand!",
          "zh": "看！你的手！哦不！我的手！",
          "audio": "g2u2_s6_02.mp3",
          "image": "g2u2_s6_02.png",
          "image_prompt": "一个小朋友的手不小心按进颜料盘，另一个小朋友惊讶地看着，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_03",
          "text": "It's OK. Let's use our hands.",
          "zh": "没关系。我们用手来画吧。",
          "audio": "g2u2_s6_03.mp3",
          "image": "g2u2_s6_03.png",
          "image_prompt": "两个小朋友把沾颜料的手掌按在画纸上画画，笑嘻嘻的，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_04",
          "text": "A green hand, a red hand.",
          "zh": "一只绿手，一只红手。",
          "audio": "g2u2_s6_04.mp3",
          "image": "g2u2_s6_04.png",
          "image_prompt": "画纸上出现绿色的手掌印和红色的手掌印，两个小朋友开心地看着，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_05",
          "text": "A yellow hand, a blue hand.",
          "zh": "一只黄手，一只蓝手。",
          "audio": "g2u2_s6_05.mp3",
          "image": "g2u2_s6_05.png",
          "image_prompt": "画纸上又多了黄色的手掌印和蓝色的手掌印，五彩缤纷，暖色调扁平卡通，圆角白底，无文字"
        },
