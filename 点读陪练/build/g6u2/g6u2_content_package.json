    {
      "id": "S5",
      "type": "story",
      "title": "Dragon Boat Festival",
      "lines": [
        {
          "id": "s5_01",
          "text": "The notice about the dragon boat race finally came out.",
          "zh": "赛龙舟的通知终于出来了。",
          "audio": "g6u2_s5_01.mp3",
          "image": "g6u2_s5_01.png",
          "image_prompt": "公告栏上贴着赛龙舟通知，一个孩子和爸爸站在前面看着，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s5_02",
          "text": "My dad woke up early and went to the river.",
          "zh": "我爸爸起得很早，去了河边。",
          "audio": "g6u2_s5_02.mp3",
          "image": "g6u2_s5_02.png",
          "image_prompt": "清晨爸爸走向河边，河上停着龙舟，朝阳升起，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s5_03",
          "text": "The judge counted down. The race began!",
          "zh": "裁判倒数。比赛开始了！",
          "audio": "g6u2_s5_03.mp3",
          "image": "g6u2_s5_03.png",
          "image_prompt": "裁判站在岸边吹哨，几条龙舟在河上竞速划行，桨手们奋力划桨，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s5_04",
          "text": "I ran and cheered for my dad.",
          "zh": "我跑着为爸爸加油。",
          "audio": "g6u2_s5_04.mp3",
          "image": "g6u2_s5_04.png",
          "image_prompt": "孩子在岸边跑着为爸爸的龙舟加油，挥舞着小旗子，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s5_05",
          "text": "His team won the race!",
          "zh": "他的队赢了比赛！",
          "audio": "g6u2_s5_05.mp3",
          "image": "g6u2_s5_05.png",
          "image_prompt": "爸爸的龙舟冲过终点线获胜，队员欢呼，岸边观众鼓掌，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s5_06",
          "text": "Our family made zongzi and had a big dinner.",
          "zh": "我们家包了粽子，吃了一顿丰盛的晚餐。",
          "audio": "g6u2_s5_06.mp3",
          "image": "g6u2_s5_06.png",
          "image_prompt": "一家人在家围桌包粽子，桌上摆满粽子和丰盛的晚餐，大家开心地笑，暖色调扁平卡通，圆角白底，无文字"
        }
      ]
