    "textbook_lyrics": {
      "title": "Unit Chant",
      "type": "textbook_lyrics",
      "chants": [
        {
          "id": "chant1",
          "name": "Appendix Song: Getting together",
          "lines": [
            {
              "en": "My family and I, we have a great time.",
              "zh": "我和家人过得很开心。"
            },
            {
              "en": "We get together at special events.",
              "zh": "我们在特殊日子团聚。"
            },
            {
              "en": "Events are fun. I love every one.",
              "zh": "活动很有趣，我喜欢每一个。"
            },
            {
              "en": "Yeah, yeah, yeah! Yeah, yeah, yeah!",
              "zh": "耶！耶！耶！"
            },
            {
              "en": "My parents and I, we had a sports day.",
              "zh": "我和父母举办了运动日。"
            },
            {
              "en": "There were many fun activities to do.",
              "zh": "有好多有趣的活动。"
            },
            {
              "en": "We ran so fast. My brother clapped.",
              "zh": "我们跑得很快，我哥哥鼓掌。"
            },
            {
              "en": "Go, go, go! Go, go, go!",
              "zh": "加油！加油！"
            },
            {
              "en": "My mother and I, we cleaned up at New Year.",
              "zh": "我和妈妈新年大扫除。"
            },
            {
              "en": "And pasted fu on our door.",
              "zh": "我们门上贴福字。"
            },
            {
              "en": "We dressed in red. All were fed.",
              "zh": "我们穿红衣，大家都吃饱。"
            },
            {
              "en": "Yum, yum, yum! Yum, yum, yum!",
              "zh": "好吃！好吃！"
            }
          ]
        }
      ]
    }
  }
