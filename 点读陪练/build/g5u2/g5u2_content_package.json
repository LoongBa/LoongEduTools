    {
      "id": "S6",
      "type": "story",
      "title": "Benjy's first snow",
      "lines": [
        {
          "id": "s6_01",
          "text": "It's snowing. I'm so excited!",
          "zh": "下雪了！我好兴奋！",
          "audio": "g5u2_s6_01.mp3",
          "image": "g5u2_s6_01.png",
          "image_prompt": "窗外正飘着大雪，一个孩子兴奋地趴在窗边看，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_02",
          "text": "Benjy looks worried. This is his first snow!",
          "zh": "本吉看起来很担心。这是他第一次见到雪！",
          "audio": "g5u2_s6_02.mp3",
          "image": "g5u2_s6_02.png",
          "image_prompt": "小狗蹲在窗边，歪着头担心地看着窗外的雪，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_03",
          "text": "Don't be afraid. It's important to try new things!",
          "zh": "别害怕。尝试新事物很重要！",
          "audio": "g5u2_s6_03.mp3",
          "image": "g5u2_s6_03.png",
          "image_prompt": "孩子蹲下来轻轻抚摸小狗，温柔地安慰它，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_04",
          "text": "He needs to exercise. Let's play with him.",
          "zh": "他需要活动一下。我们和他一起玩吧。",
          "audio": "g5u2_s6_04.mp3",
          "image": "g5u2_s6_04.png",
          "image_prompt": "孩子在雪地里抛雪球，小狗好奇地看着他，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_05",
          "text": "He's happy now. He likes the snow.",
          "zh": "他现在开心了。他喜欢雪。",
          "audio": "g5u2_s6_05.mp3",
          "image": "g5u2_s6_05.png",
          "image_prompt": "小狗在雪地里开心地跑跳，孩子在一旁笑着，暖色调扁平卡通，圆角白底，无文字"
        },
        {
          "id": "s6_06",
          "text": "Don't worry. We can play in the snow again tomorrow!",
          "zh": "别担心。我们明天还可以玩雪！",
          "audio": "g5u2_s6_06.mp3",
          "image": "g5u2_s6_06.png",
          "image_prompt": "孩子和小狗在雪地里玩耍，夕阳下约定明天再玩雪，暖色调扁平卡通，圆角白底，无文字"
        }
      ]
