          "name": "Appendix Song: My friend Sam is angry",
          "lines": [
            {
              "en": "My friend Sam is angry.",
              "zh": "我的朋友山姆生气了。"
            },
            {
              "en": "Yes, he is, he is.",
              "zh": "是的，他是。"
            },
            {
              "en": "My friend Sam is sad. Oh yes, he is.",
              "zh": "我的朋友山姆很难过，哦是的。"
            },
            {
              "en": "My friend Sam's dog is sick.",
              "zh": "山姆的狗生病了。"
            },
            {
              "en": "His dad's away.",
              "zh": "他爸爸不在家。"
            },
            {
              "en": "He's having a horrible day.",
              "zh": "他今天过得很糟糕。"
            },
            {
              "en": "My friend Sam's so unhappy.",
              "zh": "我的朋友山姆很不开心。"
            },
            {
              "en": "Yes, he is, he is.",
              "zh": "是的，他是。"
            },
            {
              "en": "My friend Sam is happy again.",
              "zh": "我的朋友山姆又开心了。"
            },
            {
              "en": "Yes, he is, he is.",
              "zh": "是的，他是。"
            },
            {
              "en": "My friend Sam's excited. Oh yes, he is.",
              "zh": "我的朋友山姆很兴奋，哦是的。"
            },
            {
              "en": "My friend Sam's dog is well.",
              "zh": "山姆的狗好了。"
            },
            {
              "en": "His dad's come home to play.",
              "zh": "他爸爸回家陪他玩了。"
            },
            {
              "en": "He's having a great day.",
              "zh": "他今天过得很棒。"
            },
            {
              "en": "Sam is very happy. Yes, he is, he is.",
              "zh": "山姆很开心，是的。"
